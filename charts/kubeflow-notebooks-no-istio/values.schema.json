{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "kubeflow-notebooks-no-istio values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      }
    },
    "notebookController": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "repository"
          ]
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "clusterDomain": {
          "type": "string",
          "minLength": 1
        },
        "culling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "idleTimeMinutes": {
              "type": "integer",
              "minimum": 1
            },
            "checkPeriodMinutes": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "userClusterRoles": {
          "type": "boolean"
        },
        "extraEnv": {
          "type": "array"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "routeController": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "repository"
          ]
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "accessVerb": {
          "type": "string",
          "minLength": 1
        },
        "userPrefix": {
          "type": "string"
        },
        "groupPrefix": {
          "type": "string"
        },
        "ignoredSubjectPrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resyncPeriod": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
        },
        "maxConcurrentReconciles": {
          "type": "integer",
          "minimum": 1
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "error"
          ]
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "gatewayPeers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "namespaceSelector": {
                "type": "object"
              },
              "podSelector": {
                "type": "object"
              },
              "ipBlock": {
                "type": "object"
              }
            },
            "additionalProperties": false,
            "minProperties": 1
          }
        },
        "extraPeers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "namespaceSelector": {
                "type": "object"
              },
              "podSelector": {
                "type": "object"
              },
              "ipBlock": {
                "type": "object"
              }
            },
            "additionalProperties": false,
            "minProperties": 1
          }
        }
      },
      "additionalProperties": false
    },
    "gateway": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "createGatewayClass": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string"
        },
        "className": {
          "type": "string",
          "minLength": 1
        },
        "sectionName": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "description": "Public hostname of Kubeflow (required).",
          "pattern": "^$|^(\\*\\.)?[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "listener": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "protocol": {
              "type": "string",
              "enum": [
                "HTTPS",
                "HTTP"
              ]
            },
            "tlsSecretName": {
              "type": "string"
            },
            "allowedRoutes": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "properties": {
        "oidc": {
          "type": "object",
          "properties": {
            "issuer": {
              "type": "string",
              "description": "OIDC issuer URL (required).",
              "pattern": "^$|^https://"
            },
            "clientID": {
              "type": "string"
            },
            "clientSecret": {
              "type": "object",
              "properties": {
                "existingSecret": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "jwksURI": {
              "type": "string",
              "description": "Address from which Envoy Gateway fetches the JWKS; may be an in-cluster http URL.",
              "pattern": "^$|^https?://"
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "contains": {
                "const": "openid"
              }
            }
          },
          "additionalProperties": false
        },
        "jwt": {
          "type": "object",
          "properties": {
            "providerName": {
              "type": "string",
              "minLength": 1
            },
            "userClaim": {
              "type": "string",
              "minLength": 1
            },
            "groupsClaim": {
              "type": "string"
            },
            "audiences": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "userIdHeader": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+$"
        }
      },
      "additionalProperties": false
    },
    "oauth2Proxy": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "repository"
          ]
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "cookieSecret": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "cookieName": {
          "type": "string",
          "minLength": 1
        },
        "cookieExpire": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
        },
        "cookieDomain": {
          "type": "string"
        },
        "headersToExtAuth": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "apiRoutes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sessionStore": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "cookie",
                "redis"
              ]
            },
            "redis": {
              "type": "object",
              "properties": {
                "create": {
                  "type": "boolean"
                },
                "connectionURL": {
                  "type": "string"
                },
                "existingSecret": {
                  "type": "string"
                },
                "image": {
                  "type": "object",
                  "properties": {
                    "repository": {
                      "type": "string",
                      "minLength": 1
                    },
                    "tag": {
                      "type": "string"
                    },
                    "pullPolicy": {
                      "type": "string",
                      "enum": [
                        "Always",
                        "IfNotPresent",
                        "Never"
                      ]
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "repository"
                  ]
                },
                "resources": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraEnv": {
          "type": "array"
        },
        "extraVolumes": {
          "type": "array"
        },
        "extraVolumeMounts": {
          "type": "array"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "jupyterWebApp": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "repository"
          ]
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "prefix": {
          "type": "string",
          "pattern": "^/[^/].*[^/]$|^/[^/]$"
        },
        "ui": {
          "type": "string"
        },
        "secureCookies": {
          "type": "boolean"
        },
        "spawnerUIConfig": {
          "type": "object"
        },
        "redirectRoot": {
          "type": "boolean"
        },
        "namespaceFilter": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "envoy-gateway": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
